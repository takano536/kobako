{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kobako-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "DEMO_MODE": "1",
    "DEMO_DB_DRIVER": "neon",
  },
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
}
