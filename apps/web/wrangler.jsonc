{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kobako-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "DEMO_MODE": "1",
  },
  "routes": [
    {
      "pattern": "demo.example.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
}
