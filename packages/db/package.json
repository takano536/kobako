{
  "name": "@kobako/db",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./money-manager": {
      "types": "./dist/money-manager.d.ts",
      "import": "./dist/money-manager.js"
    },
    "./test-fixtures": {
      "types": "./dist/test-fixtures/money-manager-workbook.d.ts",
      "import": "./dist/test-fixtures/money-manager-workbook.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "saxes": "6.0.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0",
    "drizzle-kit": "0.31.11",
    "fflate": "0.8.3"
  }
}
