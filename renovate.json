{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "automerge": false,
  "platformAutomerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 10am on wednesday"]
  },
  "packageRules": [
    {
      "description": "Next.js ecosystem",
      "groupName": "Next.js ecosystem",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^next$/",
        "/^react$/",
        "/^react-dom$/",
        "/^@types/react/",
        "/^eslint-config-next$/",
        "/^@next//"
      ]
    },
    {
      "description": "Drizzle ORM",
      "groupName": "Drizzle",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^drizzle-orm$/", "/^drizzle-kit$/"]
    },
    {
      "description": "Vitest",
      "groupName": "Vitest",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^vitest$/", "/^@vitest//"]
    },
    {
      "description": "Playwright",
      "groupName": "Playwright",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^@playwright/test$/", "/^mcr\\.microsoft\\.com/playwright$/"],
      "matchDatasources": ["npm", "docker"]
    },
    {
      "description": "ESLint ecosystem",
      "groupName": "ESLint ecosystem",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^eslint$/", "/^typescript-eslint$/", "/^@eslint//", "/^globals$/"]
    },
    {
      "description": "GitHub Actions",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"]
    },
    {
      "description": "@types/node version constraint for Node 24 LTS",
      "matchPackageNames": ["/^@types/node$/"],
      "allowedVersions": "<25"
    },
    {
      "description": "TypeScript major updates require approval",
      "matchPackageNames": ["/^typescript$/"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Node.js major version updates require approval",
      "matchPackageNames": ["/^node$/"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "PostgreSQL Docker images - major updates require approval",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^postgres$/"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
